# Copy this file to .env and fill in your values
# Never commit .env to git — it's already in .gitignore

# Your wallet's private key (without 0x prefix)
# Export from MetaMask: Account Details → Export Private Key
PRIVATE_KEY=your_private_key_here

# Sepolia RPC URL — get a free one from Alchemy or Infura
# Alchemy: https://dashboard.alchemy.com → Create App → Sepolia → API Key
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Etherscan API key — for contract verification
# Get free at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: CoinMarketCap key for gas cost in USD in the gas reporter
COINMARKETCAP_API_KEY=
